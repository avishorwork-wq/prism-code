{
  "name": "Prism Code",
  "short_name": "Prism",
  "description": "Create and read Prism Codes, a color code that holds more. Free, offline.",
  "start_url": "./index.html?source=pwa",
  "scope": "./",
  "display": "standalone",
  "orientation": "any",
  "background_color": "#ffffff",
  "theme_color": "#ffffff",
  "icons": [
    {
      "src": "brand/icon-192.png",
      "sizes": "192x192",
      "type": "image/png"
    },
    {
      "src": "brand/icon-512.png",
      "sizes": "512x512",
      "type": "image/png"
    },
    {
      "src": "brand/icon-maskable-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    },
    {
      "src": "brand/prism-app-icon.svg",
      "sizes": "any",
      "type": "image/svg+xml"
    }
  ],
  "shortcuts": [
    {
      "name": "Scan a code",
      "url": "./fast-camera.html",
      "icons": [
        {
          "src": "brand/icon-192.png",
          "sizes": "192x192"
        }
      ]
    },
    {
      "name": "Create a code",
      "url": "./index.html#generate",
      "icons": [
        {
          "src": "brand/icon-192.png",
          "sizes": "192x192"
        }
      ]
    }
  ],
  "share_target": {
    "action": "./share-target",
    "method": "POST",
    "enctype": "multipart/form-data",
    "params": {
      "title": "title",
      "text": "text",
      "files": [
        {
          "name": "image",
          "accept": [
            "image/*"
          ]
        }
      ]
    }
  }
}